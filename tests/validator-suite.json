{
  "xsd": [
    {
      "schema": "./schema.xsd",
      "tests": [
        {
          "file": "files/valid.xml",
          "errors": []
        },
        {
          "file": "files/invalid.xml",
          "errors": [
            {
              "message": "attribute id='x': invalid literal for int() with base 10: 'x'",
              "position": {
                "xpath": "/a/b"
              }
            },
            {
              "message": "The content of element 'a' is not complete. Tag 'b' expected.",
              "position": {
                "xpath": "/a"
              }
            }
          ]
        },
        {
          "file": "files/broken.xml",
          "errors": [
            {
              "message": "StartTag: invalid element name",
              "position": { "line": "1",  "linecol": "1:2" }
            }
          ]
        }
      ]
    }
  ],
  "schematron": [
    {
      "schema": "./schema.sch",
      "tests": [
        {
          "data": "<",
          "errors": [ {
            "message": "StartTag: invalid element name",
            "position": {"line": "1", "linecol": "1:2"}
          } ]
        },
        {
          "data": "<a><b id=\"1\"/></a>",
          "errors": []
        },
        {
          "data": "<a><b/></a>",
          "errors": [
            {
              "message": "There must be an id",
              "position": { "xpath": "/a[1]/b[1]"}
            }
          ]
        }
      ]
    }
  ]
}
